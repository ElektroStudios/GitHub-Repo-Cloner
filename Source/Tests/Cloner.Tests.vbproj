<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48</TargetFrameworks>
    <TargetFrameworks Condition="'$(PortableTests)' == 'true'">net48;net10.0</TargetFrameworks>
    <RootNamespace>GitHub_Repo_Cloner.Tests</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <MyType>Empty</MyType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Cloner.Core.vbproj" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <Import Include="Xunit" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Include="../GitHub Repo Cloner/Services/TokenStore.vb" Link="Services/TokenStore.vb" />
    <Compile Include="../GitHub Repo Cloner/UI/ForkCheckBox.vb" Link="UI/ForkCheckBox.vb" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
